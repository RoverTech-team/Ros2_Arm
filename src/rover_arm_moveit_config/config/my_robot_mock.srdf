<robot name="my_robot_mock">
<group name="arm">
<joint name="j1_joint"/>
<joint name="j2_joint"/>
<joint name="j3_joint"/>
<joint name="ee_base_joint_x"/>
<joint name="ee_base_joint_y"/>
<joint name="ee_base_to_tool0"/>
</group>
<group name="arm_chain">
<chain base_link="arm_base_link" tip_link="tool0"/>
</group>
<group name="gripper">
<joint name="slider_joint"/>
</group>
<group_state name="open" group="gripper">
<joint name="slider_joint" value="0.05"/>
</group_state>
<group_state name="closed" group="gripper">
<joint name="slider_joint" value="0.0"/>
</group_state>
<group_state name="home" group="arm">
<joint name="j1_joint" value="0"/>
<joint name="j2_joint" value="0"/>
<joint name="j3_joint" value="0"/>
<joint name="ee_base_joint_x" value="0"/>
<joint name="ee_base_joint_y" value="0"/>
</group_state>
<virtual_joint name="world_to_base_footprint" type="floating" parent_frame="odom" child_link="base_footprint"/>
<disable_collisions link1="arm_base_link" link2="base" reason="Adjacent"/>
<disable_collisions link1="arm_base_link" link2="body_frame" reason="Never"/>
<disable_collisions link1="base" link2="j1" reason="Adjacent"/>
<disable_collisions link1="j1" link2="j2" reason="Adjacent"/>
<disable_collisions link1="j2" link2="j3" reason="Adjacent"/>
<disable_collisions link1="j3" link2="ee_base_dummy" reason="Adjacent"/>
<disable_collisions link1="ee_base_dummy" link2="ee_base" reason="Adjacent"/>
<disable_collisions link1="j3" link2="ee_base" reason="Never"/>
<disable_collisions link1="j2" link2="ee_base" reason="Never"/>
<disable_collisions link1="ee_base" link2="ee_slider" reason="Adjacent"/>
<disable_collisions link1="ee_base" link2="ee_finger1" reason="Adjacent"/>
<disable_collisions link1="ee_base" link2="ee_finger2" reason="Adjacent"/>
<disable_collisions link1="ee_slider" link2="ee_finger1" reason="Adjacent"/>
<disable_collisions link1="ee_slider" link2="ee_finger2" reason="Adjacent"/>
<disable_collisions link1="arm_base_link" link2="j2" reason="Never"/>
<!--
 Simulazione Gazebo: sovrapposizioni accettate nel modello semplificato.
       Non disabilitare il controllo delle collisioni con il pannello. 
-->
<disable_collisions link1="base" link2="body_frame" reason="Default"/>
<disable_collisions link1="body_front_left_wheel_link" link2="body_left_suspension" reason="Default"/>
<disable_collisions link1="body_front_right_wheel_link" link2="body_right_suspension" reason="Default"/>
<disable_collisions link1="body_left_sub_suspension" link2="body_left_suspension" reason="Default"/>
<disable_collisions link1="body_left_sub_suspension" link2="body_mid_left_wheel_link" reason="Default"/>
<disable_collisions link1="body_left_sub_suspension" link2="body_rear_left_wheel_link" reason="Default"/>
<disable_collisions link1="body_mid_right_wheel_link" link2="body_right_sub_suspension" reason="Default"/>
<disable_collisions link1="body_rear_right_wheel_link" link2="body_right_sub_suspension" reason="Default"/>
<disable_collisions link1="body_right_sub_suspension" link2="body_right_suspension" reason="Default"/>
<disable_collisions link1="ee_base" link2="gemini_camera_link" reason="Adjacent"/>
<passive_joint name="mount_joint"/>
</robot>
