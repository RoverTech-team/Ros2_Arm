 <inertial>
 <mass value="0.3"/>
 <inertia ixx="1.6e-4" ixy="0" ixz="0" iyy="4.1e-4" iyz="0" izz="2.5e-4"/>
 </inertial>
 </link>
 <joint name="metal_plate_joint" type="fixed">
 <parent link="panel_base"/>
 <child link="metal_plate"/>
 <origin xyz="0.240 0.035 0.075" rpy="0 0 0"/>
 </joint>

 <!-- ============================================ -->
 <!-- BOTTOM LEFT BLACK CUTOUT -->
 <!-- ============================================ -->
 <link name="black_cutout">
 <visual>
 <origin xyz="0 0 0" rpy="0 0 0"/>
 <geometry><box size="0.045 0.002 0.045"/></geometry>
 <material name="dark_gray">
 <color rgba="0.2 0.2 0.2 1"/>
 </material>
 </visual>
 <inertial>
 <mass value="0.05"/>
 <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
 </inertial>
 </link>
 <joint name="black_cutout_joint" type="fixed">
 <parent link="panel_base"/>
 <child link="black_cutout"/>
 <origin xyz="0.060 -0.002 0.050" rpy="0 0 0"/>
 </joint>

 <!-- ============================================ -->
 <!-- SIDE HANDLE (left wall) -->
 <!-- ============================================ -->
 <link name="side_handle">
 <visual>
 <origin xyz="0 0 0" rpy="0 0 0"/>
 <geometry><box size="0.020 0.030 0.150"/></geometry>
 <material name="metal"/>
 </visual>
 <collision>
 <origin xyz="0 0 0" rpy="0 0 0"/>
 <geometry><box size="0.020 0.030 0.150"/></geometry>
 </collision>
 <inertial>
 <mass value="0.05"/>
 <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
 </inertial>
 </link>
 <joint name="side_handle_joint" type="fixed">
 <parent link="panel_base"/>
 <child link="side_handle"/>
 <origin xyz="-0.010 -0.090 0.225" rpy="0 0 0"/>
 </joint>

 </xacro:macro>

 <xacro:panel_description/>
 <xacro:panel_ros2_control name="maintenance_panel" use_gazebo="$(optenv use_gazebo false)"/>

  <!-- Gazebo-only tags -->
  <xacro:if value="$(optenv use_gazebo false)">
  <gazebo>
<plugin name="gz_ros2_control::GazeboSimSystem" filename="gz_ros2_control-system">
    <robot_param_node>panel_robot_state_publisher</robot_param_node>
    <parameters>$(optenv panel_ctrl_yaml /tmp/panel_controller.yaml)</parameters>
    <ros>
      <namespace>panel</namespace>
      <remapping>joint_states:=/panel/joint_states</remapping>
    </ros>
  </plugin>
  </gazebo>

  <!-- Lever switch plugins -->
  <gazebo>
  <plugin name="" filename="liblever_switch_plugin">
    <joint>main_switch</joint>
    <off_position>-1.57</off_position>
    <on_position>1.57</on_position>
    <detent_stiffness>0.4</detent_stiffness>
  </plugin>
  </gazebo>

  <gazebo>
  <plugin name="" filename="liblever_switch_plugin">
    <joint>lever_switch_1</joint>
    <off_position>-1.57</off_position>
    <on_position>1.57</on_position>
    <detent_stiffness>0.4</detent_stiffness>
  </plugin>
  </gazebo>

  <gazebo>
  <plugin name="" filename="liblever_switch_plugin">
    <joint>lever_switch_2</joint>
    <off_position>-1.57</off_position>
    <on_position>1.57</on_position>
    <detent_stiffness>0.4</detent_stiffness>
  </plugin>
  </gazebo>

  <gazebo>
  <plugin name="" filename="liblever_switch_plugin">
    <joint>lever_switch_3</joint>
    <off_position>-1.57</off_position>
    <on_position>1.57</on_position>
    <detent_stiffness>0.4</detent_stiffness>
  </plugin>
  </gazebo>

  <gazebo>
  <plugin name="" filename="liblever_switch_plugin">
    <joint>lever_switch_4</joint>
    <off_position>-1.57</off_position>
    <on_position>1.57</on_position>
    <detent_stiffness>0.4</detent_stiffness>
  </plugin>
  </gazebo>

  <!-- Rotary switch plugins -->
  <gazebo>
  <plugin name="" filename="librotary_switch_plugin">
    <joint>rotary_switch_1</joint>
    <friction_torque>0.05</friction_torque>
  </plugin>
  </gazebo>

  <gazebo>
  <plugin name="" filename="librotary_switch_plugin">
    <joint>rotary_switch_2</joint>
    <friction_torque>0.05</friction_torque>
  </plugin>
  </gazebo>

  <gazebo>
  <plugin name="" filename="librotary_switch_plugin">
    <joint>rotary_switch_3</joint>
    <friction_torque>0.05</friction_torque>
  </plugin>
  </gazebo>

  <gazebo>
  <plugin name="" filename="librotary_switch_plugin">
    <joint>rotary_switch_4</joint>
    <friction_torque>0.05</friction_torque>
  </plugin>
  </gazebo>

  <gazebo>
  <plugin name="" filename="librotary_switch_plugin">
    <joint>rotary_switch_5</joint>
    <friction_torque>0.05</friction_torque>
  </plugin>
  </gazebo>

  <gazebo>
  <plugin name="" filename="librotary_switch_plugin">
    <joint>power_switch_1</joint>
    <friction_torque>0.08</friction_torque>
  </plugin>
  </gazebo>

  <gazebo>
  <plugin name="" filename="librotary_switch_plugin">
    <joint>power_switch_2</joint>
    <friction_torque>0.08</friction_torque>
  </plugin>
  </gazebo>

 <!-- Panel base friction -->
 <gazebo reference="panel_base">
 <mu1>0.8</mu1>
 <mu2>0.8</mu2>
 </gazebo>
 </xacro:if>
</robot>
