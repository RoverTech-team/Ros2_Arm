<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="maintenance_panel">
 <xacro:include filename="$(find rover_arm_panel_description)/urdf/panel.ros2_control.xacro"/>

 <xacro:macro name="panel_description">

 <link name="panel_base_frame">
 <inertial>
 <mass value="0.001"/>
 <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
 </inertial>
 </link>

 <joint name="panel_base_frame_to_panel_base" type="fixed">
 <parent link="panel_base_frame"/>
 <child link="panel_base"/>
    <origin xyz="1.5 0 0" rpy="0 0 1.571"/>
 </joint>

 <!-- ============================================= -->
 <!-- ENCLOSURE: Sloped trapezoidal white body -->
 <!-- Front face at Y=0, back extends in -Y -->
 <!-- Bottom: ~180mm deep, Top: ~60mm deep -->
 <!-- Mesh: trapezoidal prism, 8 vertices, 6 faces -->
 <!-- ============================================= -->
 <link name="panel_base">
 <visual>
 <origin xyz="0.165 -0.060 0.225" rpy="0 0 0"/>
 <geometry>
 <mesh filename="package://rover_arm_panel_description/meshes/visual/panel_base.dae"/>
 </geometry>
 <material name="white">
 <color rgba="0.9 0.9 0.9 1"/>
 </material>
 </visual>
 <collision>
 <origin xyz="0.165 -0.060 0.225" rpy="0 0 0"/>
 <geometry>
 <mesh filename="package://rover_arm_panel_description/meshes/visual/panel_base.dae"/>
 </geometry>
 </collision>
 <!-- Invisible support foot: extends the ground contact polygon under the
      front-mounted parts (sockets, electromagnet, plate) whose mass center
      projects in front of the trapezoid's leading edge (root x=1.5). Without
      it the COM falls outside the support polygon and the panel tips over. -->
 <collision name="front_foot">
 <origin xyz="0.165 0.05 0.0" rpy="0 0 0"/>
 <geometry>
 <box size="0.40 0.10 0.01"/>
 </geometry>
 </collision>
 <inertial>
 <mass value="10.0"/>
 <inertia ixx="0.738" ixy="0" ixz="0" iyy="1.038" iyz="0" izz="0.426"/>
 </inertial>
 </link>

 <!-- ============================================ -->
 <!-- ARUCO TAGS (top corners, above indicators) -->
 <!-- ============================================ -->
 <link name="aruco_tag_0">
 <visual>
 <origin xyz="0 0 0" rpy="0 0 0"/>
 <geometry><box size="0.045 0.001 0.045"/></geometry>
 <material name="white"/>
 </visual>
 <inertial>
 <mass value="0.05"/>
 <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
 </inertial>
 </link>
 <joint name="aruco_tag_0_joint" type="fixed">
 <parent link="panel_base"/>
 <child link="aruco_tag_0"/>
 <origin xyz="0.050 0.001 0.405" rpy="0 0 0"/>
 </joint>

 <link name="aruco_tag_1">
 <visual>
 <origin xyz="0 0 0" rpy="0 0 0"/>
 <geometry><box size="0.045 0.001 0.045"/></geometry>
 <material name="white"/>
 </visual>
 <inertial>
 <mass value="0.05"/>
 <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
 </inertial>
 </link>
 <joint name="aruco_tag_1_joint" type="fixed">
 <parent link="panel_base"/>
 <child link="aruco_tag_1"/>
 <origin xyz="0.280 0.001 0.405" rpy="0 0 0"/>
 </joint>

