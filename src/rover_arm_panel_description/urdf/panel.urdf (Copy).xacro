 <!-- ============================================ -->
 <!-- TOGGLE SWITCHES (5 red lever type) -->
 <!-- Axis 1 0 0 = pitch rotation (up/down toggle) -->
 <!-- ============================================ -->
 <!-- Main switch -->
 <link name="main_switch_knob">
 <visual>
 <origin xyz="0 0.0175 0" rpy="0 0 0"/>
 <geometry><box size="0.008 0.035 0.006"/></geometry>
 <material name="red">
 <color rgba="0.8 0.1 0.1 1"/>
 </material>
 </visual>
 <visual>
 <origin xyz="0 0 0" rpy="1.5708 0 0"/>
 <geometry><cylinder radius="0.006" length="0.008"/></geometry>
 <material name="red"/>
 </visual>
 <collision>
 <origin xyz="0 0.0175 0" rpy="0 0 0"/>
 <geometry><box size="0.008 0.035 0.006"/></geometry>
 </collision>
 <inertial>
 <mass value="0.02"/>
 <inertia ixx="2.8e-6" ixy="0" ixz="0" iyy="2.8e-6" iyz="0" izz="2.6e-6"/>
 </inertial>
 </link>
 <joint name="main_switch" type="revolute">
 <parent link="panel_base"/>
 <child link="main_switch_knob"/>
 <origin xyz="0.050 0.020 0.220" rpy="0 0 0"/>
 <axis xyz="1 0 0"/>
 <limit lower="-1.57" upper="1.57" effort="5.0" velocity="2.0"/>
 </joint>

