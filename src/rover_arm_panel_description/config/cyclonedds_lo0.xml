<?xml version="1.0" encoding="UTF-8"?>
<!-- CycloneDDS pinnato su lo0: senza questo, su questa macchina la discovery
     tra processi non funziona (rmw_create_node / TF disconnessa). Tenuto nel
     repo, NON in /tmp, cosi' non sparisce con la pulizia dei temporanei. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo0" priority="default" multicast="default"/>
      </Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
    </General>
  </Domain>
</CycloneDDS>
