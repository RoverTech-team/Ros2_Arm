<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gemini_camera">

  <!-- 1. Link fisico della telecamera -->
  <link name="gemini_camera_link">
    <visual>
      <origin xyz="0.0 0 0.0" rpy="0  0  0"/>
      <geometry>
        <box size="0.023 0.042 0.042"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.023 0.042 0.042"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.068"/>
      <inertia ixx="0.000020" ixy="0.0" ixz="0.0" iyy="0.000013" iyz="0.0" izz="0.000013"/>
    </inertial>
  </link>

  <!-- 2. Giunto di ancoraggio al rover -->
  <joint name="camera_rover_mount_joint" type="fixed">
    <parent link="arm_base_link"/> 
    <child link="gemini_camera_link"/>
    <!-- Le coordinate xyz dovranno riflettere la posizione reale sul veicolo -->
    <origin xyz="0.0 0.0 0.0" rpy="0 0 3.14"/> 
  </joint>

  <!-- 3. Link e giunto ottico -->
  <link name="gemini_camera_optical_frame"/>
  
  <joint name="camera_optical_joint" type="fixed">
    <parent link="gemini_camera_link"/>
    <child link="gemini_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>
<!-- 4. Definizione in gazebo!! -->

<gazebo reference="gemini_camera_link">
  <sensor name="gemini_camera" type="rgbd_camera">
    <pose>0 0 0 -1.570796 0 -1.570796</pose>
    <frame_id>gemini_camera_optical_frame</frame_id>
    <always_on>true</always_on>
    <update_rate>30.0</update_rate>
    <topic>/camera/rgbd</topic>
    <camera>
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
      </image>
      <clip>
        <near>0.2</near>
        <far>8.0</far>
      </clip>
      <optical_frame_id>gemini_camera_optical_frame</optical_frame_id>
    </camera>
  </sensor>
</gazebo>
</robot>
