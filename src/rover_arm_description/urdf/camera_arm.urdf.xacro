<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gemini_camera">

  <!--
    ORBBEC GEMINI 305

    Dimensioni: 42 x 42 x 23 mm
    Massa: 68 g

    Convenzione degli assi:
      +X_link : alto della camera
      -Y_link : direzione di osservazione
      +Z_link : destra dell'immagine

    La profondita' fisica di 23 mm e' lungo Y.
  -->

  <!-- =========================================== -->
  <!-- 1. CORPO FISICO DELLA CAMERA                -->
  <!-- =========================================== -->

  <link name="gemini_camera_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.042 0.023 0.042"/>
      </geometry>

      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>

    <!-- Collisione con dimensioni reali -->

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.042 0.023 0.042"/>
      </geometry>
    </collision>

    <!--
      Massa ufficiale Gemini 305: 68 g.

      Inerzia approssimata come parallelepipedo
      omogeneo rispetto al proprio centro di massa.
    -->

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="0.068"/>

      <inertia
        ixx="0.000012993667"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000019992000"
        iyz="0.0"
        izz="0.000012993667"/>
    </inertial>

  </link>


  <!-- =========================================== -->
  <!-- 2. MONTAGGIO DELLA CAMERA SUL BRACCIO       -->
  <!-- =========================================== -->

  <!--
    Manteniamo il montaggio originale su ee_base.

    La camera viene orientata in modo che
    la direzione di osservazione sia +Y di ee_base.

    Il montaggio dovra' essere verificato
    fisicamente prima delle prove di contatto.
  -->

  <!-- Supporto laterale da 10 cm, PERPENDICOLARE al piano di apertura
       delle dita: le dita si aprono lungo Z (finger1 a z=-0.055, finger2 a
       z=+0.055) e si estendono lungo Y; il supporto esce lungo X.
       Serve a portare la camera fuori dall'ombra delle dita.
       SOLO VISUAL: nessuna collision, per non introdurre un ingombro che
       bloccherebbe la pianificazione a 5-8 cm dal pannello. Su hardware
       reale il supporto va progettato e poi aggiunto anche come collision. -->
  <link name="camera_support_link">
    <visual>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.016 0.016"/>
      </geometry>
      <material name="support_grey">
        <color rgba="0.35 0.35 0.38 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0"
               izz="0.00005"/>
    </inertial>
  </link>

  <joint name="camera_support_joint" type="fixed">

    <parent link="ee_base"/>

    <child link="camera_support_link"/>

    <!-- Ottimizzato con optimize_camera_mount.py (CMA-ES, 6 DOF):
         porta la camera a dt=(-4.6,-1.3,+3.1) cm e drpy=(+2.8,+1.6,+2.3) deg
         rispetto al montaggio precedente (0.03 0.09 0.0). Con questa terna
         tutte e 5 le leve restano nel FOV a 8/6/5 cm con il dito fuori. -->
    <origin
      xyz="-0.0153 0.0721 0.0333"
      rpy="0.04887 0.02793 0.04014"/>

  </joint>

  <joint name="camera_rover_mount_joint" type="fixed">

    <parent link="camera_support_link"/>

    <child link="gemini_camera_link"/>

    <origin
      xyz="0.10 0.0 0.0"
      rpy="0 0 3.141593"/>

  </joint>


  <!-- =========================================== -->
  <!-- 3. FRAME OTTICO DELLA CAMERA               -->
  <!-- =========================================== -->

  <!--
    Convenzione ROS Optical Frame:

    +X: destra nell'immagine
    +Y: basso nell'immagine
    +Z: direzione di osservazione

    Il corpo e' centrato nell'origine del link.

    La superficie anteriore si trova a:
    Y = -0.0115 m

    Il datasheet indica che l'origine depth
    si trova circa 3.95 mm dietro il vetro.

    Pertanto, assumendo il corpo centrato:
    Y = -0.0115 + 0.00395 = -0.00755 m

    L'offset trasversale dell'ottica non e'
    modellato: richiede il CAD/calibrazione.
  -->

  <link name="gemini_camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">

    <parent link="gemini_camera_link"/>

    <child link="gemini_camera_optical_frame"/>

    <origin
      xyz="0 -0.00755 0"
      rpy="1.570796 -1.570796 0"/>

  </joint>


  <!-- =========================================== -->
  <!-- 4. PRESERVAZIONE DEI JOINT IN GAZEBO        -->
  <!-- =========================================== -->

  <gazebo reference="camera_rover_mount_joint">

    <preserveFixedJoint>true</preserveFixedJoint>

  </gazebo>

  <!-- Anche il supporto va preservato: senza, urdf2sdf lo FONDE in ee_base e
       il joint figlio (camera_rover_mount_joint) resta appeso a un link che
       non esiste piu'. Il render finiva a ~10 cm dal frame ottico usato da
       TF: errore invisibile guardando lungo il supporto (posa di pre-aim,
       misurato 6 px sui due ArUco) e grande quanto il supporto quando la
       camera e' di traverso (330 px a 0.2 m). -->
  <gazebo reference="camera_support_joint">

    <preserveFixedJoint>true</preserveFixedJoint>

  </gazebo>

  <gazebo reference="camera_optical_joint">

    <preserveFixedJoint>true</preserveFixedJoint>

  </gazebo>


  <!-- =========================================== -->
  <!-- 5. SENSORE GEMINI 305 IN GAZEBO HARMONIC    -->
  <!-- =========================================== -->

  <!--
    Sensore RGBD con due flussi:

    RGB:
      Riconoscimento ArUco e pulsanti.

    DEPTH:
      Misurazione delle distanze.

    Specifiche depth:
      1280 x 800 pixel
      30 FPS
      FOV orizzontale 88 gradi
      Distanza minima 0.05 m
      Distanza massima 1.0 m

    La distanza minima corrisponde alla modalita'
    Close-Range con disparity search range 256.

    Gazebo utilizza un sensore virtuale.
    Non simula il vero matching stereo Orbbec.

    Il FOV RGB reale e' di 94 gradi,
    ma qui utilizziamo 88 gradi per entrambi
    i flussi per mantenere l'allineamento.
  -->

  <gazebo reference="gemini_camera_link">

    <sensor name="gemini_camera" type="rgbd_camera">

      <!--
        Il sensore Gazebo guarda lungo +X_sensor.
        Questa rotazione lo orienta lungo -Y_link.

        La traslazione e' identica
        a quella del frame ottico.
      -->

      <!-- Posa del sensore Gazebo: il render guarda lungo +X_sensor.
             Deve coincidere con gli assi di gemini_camera_optical_frame.
             Questa rotazione orienta il render lungo -Y_link con l'immagine
             dritta: e' quella con cui sono stati presi i frame di riferimento
             (docs/media, pannello con il bordo bianco in alto).
             rpy (1.570796 -1.570796 0) [provato il 21/11] orienta il render
             lungo +Z_link: la camera guarda il cielo, il pannello esce dal FOV
             e il detector non trova piu' gli ArUco.
             rpy (1.570796 0 -1.570796) tiene la direzione ma ribalta
             l'immagine di 180 gradi (bordo bianco in basso).
             NOTA: il disallineamento mirino/leva visto il 21/11 NON era la
             terna ottica (URDF corretto per questa posa) ma il TF della base
             nominale: vedi publish_gz_base_tf.py. -->
      <pose>
        0 -0.00755 0 -1.570796 0 -1.570796
      </pose>

      <always_on>true</always_on>

      <update_rate>30.0</update_rate>

      <topic>/camera/rgbd</topic>

      <gz_frame_id>
        gemini_camera_optical_frame
      </gz_frame_id>

      <camera>

        <!-- FOV orizzontale depth: 88 gradi -->

        <horizontal_fov>1.535890</horizontal_fov>

        <!-- Risoluzione immagini -->

        <image>
          <width>1280</width>
          <height>800</height>
        </image>

        <!-- Clipping del rendering.
             near=0.01 m (era 0.05): a 5-8 cm dal pannello le dita e i
             bordi del pannello finivano DENTRO il near plane e venivano
             tagliati, lasciando porzioni di FOV non renderizzate.
             La distanza minima di misura della depth resta gestita dal
             filtro software (0.05 m), non dal clip. -->

        <clip>
          <near>0.01</near>
          <far>1.0</far>
        </clip>

        <!-- Limiti specifici della depth -->

        <depth_camera>

          <!-- Stesso near del flusso RGB: evita buchi di profondita'
               quando dita/pannello sono a pochi cm dalla camera.
               Il limite di 0.05 m della Gemini reale resta applicato
               dal filtro software del detector. -->

          <clip>
            <near>0.01</near>
            <far>1.0</far>
          </clip>

        </depth_camera>

        <!-- Frame ottico ROS -->

        <optical_frame_id>
          gemini_camera_optical_frame
        </optical_frame_id>

      </camera>

    </sensor>

  </gazebo>

</robot>
