<?xml version="1.0"?>
<robot name="rover_two_finger_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rover_two_finger_arm" params="parent prefix *origin">

    <!-- ================================================== -->
    <!-- LINK OFFSETS -->
    <!-- ================================================== -->

    <xacro:property name="base_rotation_offset" value="${pi / 2} 0 0"/>
    <xacro:property name="j1_rotation_offset" value="${pi / 2} 0 0"/>
    <xacro:property name="j2_rotation_offset" value="${pi / 6} 0 0"/>
    <xacro:property name="j3_rotation_offset" value="${pi - 0.4366117} 0 0"/>

    <!-- Specific offsets for the two-finger gripper -->
    <xacro:property name="finger1_rotation_offset" value="0 0 ${pi / 2}"/>
    <xacro:property name="finger2_rotation_offset" value="${pi} 0 ${pi / 2}"/>

    <!-- ================================================== -->
    <!-- JOINT POSITIONS -->
    <!-- ================================================== -->

    <xacro:property name="j1_joint_pos" value="0 0 0.024"/>
    <xacro:property name="j2_joint_pos" value="0.0808 0 0.071"/>
    <xacro:property name="j3_joint_pos" value="0.007 0 0.25"/>
    <xacro:property name="ee_base_joint_pos" value="-0.028 0 0.2715"/>
    <xacro:property name="slider_joint_pos" value="0 0.11 0"/>

    <!-- Two-finger joint positions -->
    <xacro:property name="finger1_joint_pos" value="0.012017 0.156 -0.054914"/>
    <xacro:property name="finger1_joint_rotation" value="0 0 0"/>

    <xacro:property name="finger2_joint_pos" value="-0.012017 0.156 0.054914"/>
    <xacro:property name="finger2_joint_rotation" value="0 0 0"/>

    <!-- ================================================== -->
    <!-- COLORS -->
    <!-- ================================================== -->

    <material name="${prefix}links_color">
      <color rgba="0.9 0.5 0.0 1.0"/>
    </material>

    <!-- ================================================== -->
    <!-- SLIDER TO FINGER CINEMATIC RELATION -->
    <!-- ================================================== -->

    <xacro:property name="slider_length" value="0.05"/>
    <xacro:property name="finger_rotation_upper_bound" value="${pi / 2}"/>
    <xacro:property name="relation_multip"
                    value="${finger_rotation_upper_bound / slider_length}"/>

    <!-- ================================================== -->
    <!-- WRIST GEAR VISUAL -->
    <!-- ================================================== -->

    <xacro:macro name="wrist_gear" params="radius length color xyz rpy">

      <visual name="gear_disc">
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="wrist_gear_mat">
          <color rgba="${color}"/>
        </material>
      </visual>

      <visual name="gear_bar_x">
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry>
          <box size="${radius * 2.0} ${radius * 0.28} ${length}"/>
        </geometry>
        <material name="wrist_gear_mat">
          <color rgba="${color}"/>
        </material>
      </visual>

      <visual name="gear_bar_y">
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry>
          <box size="${radius * 0.28} ${radius * 2.0} ${length}"/>
        </geometry>
        <material name="wrist_gear_mat">
          <color rgba="${color}"/>
        </material>
      </visual>

    </xacro:macro>

    <!-- ================================================== -->
    <!-- BASE LINK -->
    <!-- ================================================== -->

    <link name="${prefix}base">

      <visual>
        <origin xyz="0 0 0" rpy="${base_rotation_offset}"/>
        <geometry>
          <mesh
            filename="package://rover_two_finger_arm_description/meshes/visual/base.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}links_color"/>
      </visual>

      <collision>
        <origin xyz="0 0.015 -0.022" rpy="0 0 0"/>
        <geometry>
          <box size="0.153000 0.202000 0.122040"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="2.5"/>
        <inertia
          ixx="0.02" ixy="0.0" ixz="0.0"
          iyy="0.02" iyz="0.0" izz="0.02"/>
      </inertial>

    </link>

    <!-- ================================================== -->
    <!-- J1 -->
    <!-- ================================================== -->

    <link name="${prefix}j1">

      <visual>
        <origin xyz="0 0 0" rpy="${j1_rotation_offset}"/>
        <geometry>
          <mesh
            filename="package://rover_two_finger_arm_description/meshes/visual/j1.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}links_color"/>
      </visual>

      <collision>
        <origin xyz="-0.035 0 0.065" rpy="0 0 0"/>
        <geometry>
          <box size="0.23 0.07 0.08"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="1.5"/>
        <inertia
          ixx="0.01" ixy="0.0" ixz="0.0"
          iyy="0.01" iyz="0.0" izz="0.01"/>
      </inertial>

    </link>

    <!-- ================================================== -->
    <!-- J2 -->
    <!-- ================================================== -->

    <link name="${prefix}j2">

      <visual>
        <origin xyz="0 0 0" rpy="${j2_rotation_offset}"/>
        <geometry>
          <mesh
            filename="package://rover_two_finger_arm_description/meshes/visual/j2.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}links_color"/>
      </visual>

      <collision>
        <origin xyz="${0.05 / 2} 0 ${0.25 / 2}" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.32"/>
        </geometry>
      </collision>

      <collision>
        <origin xyz="${0.05 + 0.05 / 2} 0 0.185" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.17"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="1.2"/>
        <inertia
          ixx="0.008" ixy="0.0" ixz="0.0"
          iyy="0.008" iyz="0.0" izz="0.008"/>
      </inertial>

    </link>

    <!-- ================================================== -->
    <!-- J3 -->
    <!-- ================================================== -->

    <link name="${prefix}j3">

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.08 0.08 0.25"/>            
        </geometry>
        <material name="${prefix}links_color"/>
      </visual>

      <xacro:wrist_gear
        radius="0.04"
        length="0.02"
        color="0.25 0.25 0.28 1.0"
        xyz="${ee_base_joint_pos}"
        rpy="0 ${-pi / 2} 0"/>

      <collision>
        <origin xyz="${-0.05 / 2} 0 0.04" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.07 0.15"/>
        </geometry>
      </collision>

      <collision>
        <origin xyz="${-0.05 / 2} 0 0.2" rpy="0 0 0"/>
        <geometry>
          <box size="0.13 0.07 0.2"/>
        </geometry>
      </collision>

      <collision>
        <origin xyz="${-(0.05 + 0.13 + 0.04) / 2} 0 0.195" rpy="0 0 0"/>
        <geometry>
          <box size="0.04 0.07 0.13"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="1.0"/>
        <inertia
          ixx="0.006" ixy="0.0" ixz="0.0"
          iyy="0.006" iyz="0.0" izz="0.006"/>
      </inertial>

    </link>

    <!-- ================================================== -->
    <!-- END EFFECTOR BASE - TWO FINGERS -->
    <!-- ================================================== -->

    <link name="${prefix}ee_base">

      <visual>
        <origin xyz="0 0.018007 0" rpy="0 0 0"/>
        <geometry>
          <mesh
            filename="package://rover_two_finger_arm_description/meshes/visual/two_finger_version/end_effector_base.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}links_color"/>
      </visual>

      <xacro:wrist_gear
        radius="0.038"
        length="0.02"
        color="0.25 0.25 0.28 1.0"
        xyz="0 0 0"
        rpy="${pi / 2} 0 0"/>

      <collision>
        <origin xyz="0 0.07 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="0.06" length="0.12"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.6"/>
        <inertia
          ixx="0.003" ixy="0.0" ixz="0.0"
          iyy="0.003" iyz="0.0" izz="0.003"/>
      </inertial>

    </link>

    <!-- ================================================== -->
    <!-- END EFFECTOR SLIDER -->
    <!-- ================================================== -->

    <link name="${prefix}ee_slider">

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh
            filename="package://rover_two_finger_arm_description/meshes/visual/two_finger_version/end_effector_slider.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}links_color"/>
      </visual>

      <inertial>
        <mass value="0.3"/>
        <inertia
          ixx="0.002" ixy="0.0" ixz="0.0"
          iyy="0.002" iyz="0.0" izz="0.002"/>
      </inertial>

    </link>

    <!-- ================================================== -->
    <!-- END EFFECTOR FINGER 1 -->
    <!-- ================================================== -->

    <link name="${prefix}ee_finger1">

      <visual>
        <origin xyz="0 0 0" rpy="${finger1_rotation_offset}"/>
        <geometry>
          <mesh
            filename="package://rover_two_finger_arm_description/meshes/visual/two_finger_version/end_effector_finger.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}links_color"/>
      </visual>

      <collision>
        <origin xyz="0.016 ${0.14 / 2} ${-0.022 / 2}" rpy="0 0 0"/>
        <geometry>
          <box size="0.042 0.14 0.022"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.05"/>
        <inertia
          ixx="0.0005" ixy="0.0" ixz="0.0"
          iyy="0.0005" iyz="0.0" izz="0.0005"/>
      </inertial>

    </link>

    <!-- ================================================== -->
    <!-- END EFFECTOR FINGER 2 -->
    <!-- ================================================== -->

    <link name="${prefix}ee_finger2">

      <visual>
        <origin xyz="0 0 0" rpy="${finger2_rotation_offset}"/>
        <geometry>
          <mesh
            filename="package://rover_two_finger_arm_description/meshes/visual/two_finger_version/end_effector_finger.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}links_color"/>
      </visual>

      <collision>
        <origin xyz="0.016 ${0.14 / 2} ${-0.022 / 2}" rpy="0 0 0"/>
        <geometry>
          <box size="0.042 0.14 0.022"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.05"/>
        <inertia
          ixx="0.0005" ixy="0.0" ixz="0.0"
          iyy="0.0005" iyz="0.0" izz="0.0005"/>
      </inertial>

    </link>

    <!-- ================================================== -->
    <!-- JOINTS -->
    <!-- ================================================== -->

    <!-- Mount arm to rover -->

    <joint name="${prefix}mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- J1 -->

    <joint name="${prefix}j1_joint" type="continuous">
      <parent link="${prefix}base"/>
      <child link="${prefix}j1"/>
      <origin xyz="${j1_joint_pos}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <!-- J2 -->

    <joint name="${prefix}j2_joint" type="revolute">
      <parent link="${prefix}j1"/>
      <child link="${prefix}j2"/>
      <origin xyz="${j2_joint_pos}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit
        lower="-1.5808"
        upper="1.5808"
        effort="50.0"
        velocity="1.0"/>
    </joint>

    <!-- J3 -->

    <joint name="${prefix}j3_joint" type="revolute">
      <parent link="${prefix}j2"/>
      <child link="${prefix}j3"/>
      <origin xyz="${j3_joint_pos}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit
        lower="-1.5808"
        upper="1.5808"
        effort="50.0"
        velocity="1.0"/>
    </joint>

    <!-- ================================================== -->
    <!-- WRIST DUMMY LINK -->
    <!-- ================================================== -->

    <link name="${prefix}ee_base_dummy">

      <inertial>
        <mass value="0.02"/>
        <inertia
          ixx="0.0002" ixy="0.0" ixz="0.0"
          iyy="0.0002" iyz="0.0" izz="0.0002"/>
      </inertial>

      <xacro:wrist_gear
        radius="0.04"
        length="0.02"
        color="0.25 0.25 0.28 1.0"
        xyz="0 0 0"
        rpy="0 ${-pi / 2} 0"/>

      <xacro:wrist_gear
        radius="0.038"
        length="0.02"
        color="0.25 0.25 0.28 1.0"
        xyz="0 0 0"
        rpy="${pi / 2} 0 0"/>

    </link>

    <!-- ================================================== -->
    <!-- WRIST PITCH - J4 -->
    <!-- ================================================== -->

    <joint name="${prefix}ee_base_joint_x" type="revolute">
      <parent link="${prefix}j3"/>
      <child link="${prefix}ee_base_dummy"/>
      <origin xyz="${ee_base_joint_pos}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit
        lower="-0.01"
        upper="3.1516"
        effort="50.0"
        velocity="1.0"/>
    </joint>

    <!-- ================================================== -->
    <!-- WRIST ROLL - J5 -->
    <!-- ================================================== -->

    <joint name="${prefix}ee_base_joint_y" type="continuous">
      <parent link="${prefix}ee_base_dummy"/>
      <child link="${prefix}ee_base"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- ================================================== -->
    <!-- SLIDER -->
    <!-- ================================================== -->

    <joint name="${prefix}slider_joint" type="prismatic">
      <parent link="${prefix}ee_base"/>
      <child link="${prefix}ee_slider"/>
      <origin xyz="${slider_joint_pos}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit
        lower="-0.01"
        upper="0.06"
        effort="50.0"
        velocity="1.0"/>
    </joint>

    <!-- ================================================== -->
    <!-- FINGER 1 -->
    <!-- ================================================== -->

    <joint name="${prefix}finger1_joint" type="revolute">
      <parent link="${prefix}ee_base"/>
      <child link="${prefix}ee_finger1"/>
      <origin xyz="${finger1_joint_pos}" rpy="${finger1_joint_rotation}"/>
      <axis xyz="-1 0 0"/>
      <limit
        lower="0.0"
        upper="${finger_rotation_upper_bound}"
        effort="50.0"
        velocity="1.0"/>
      <mimic
        joint="${prefix}slider_joint"
        multiplier="${relation_multip}"
        offset="0.0"/>
    </joint>

    <!-- ================================================== -->
    <!-- FINGER 2 -->
    <!-- ================================================== -->

    <joint name="${prefix}finger2_joint" type="revolute">
      <parent link="${prefix}ee_base"/>
      <child link="${prefix}ee_finger2"/>
      <origin xyz="${finger2_joint_pos}" rpy="${finger2_joint_rotation}"/>
      <axis xyz="1 0 0"/>
      <limit
        lower="0.0"
        upper="${finger_rotation_upper_bound}"
        effort="50.0"
        velocity="1.0"/>
      <mimic
        joint="${prefix}slider_joint"
        multiplier="${relation_multip}"
        offset="0.0"/>
    </joint>

  </xacro:macro>

</robot>
