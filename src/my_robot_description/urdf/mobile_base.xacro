<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.865" />
    <xacro:property name="base_width" value="0.645" />
    <xacro:property name="base_height" value="0.24" />
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_length" value="0.05" />

    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
        </collision>
        <inertial>
            <mass value="40.0"/>
            <inertia ixx="1.579" ixy="0.0" ixz="0.0" iyy="3.881" iyz="0.0" izz="2.686"/>
        </inertial>
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            </collision>
            <inertial>
                <mass value="0.2"/>
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
            </inertial>
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="front_right" />
    <xacro:wheel_link prefix="middle_right" />
    <xacro:wheel_link prefix="back_right" />
    <xacro:wheel_link prefix="front_left" />
    <xacro:wheel_link prefix="middle_left" />
    <xacro:wheel_link prefix="back_left" />

    <gazebo reference="base_link">
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
        <kp>100000.0</kp>
        <kd>1000.0</kd>
    </gazebo>

    <xacro:macro name="wheel_gazebo_props" params="prefix">
        <gazebo reference="${prefix}_wheel_link">
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
            <kp>100000.0</kp>
            <kd>1000.0</kd>
        </gazebo>
    </xacro:macro>
    <xacro:wheel_gazebo_props prefix="front_right" />
    <xacro:wheel_gazebo_props prefix="middle_right" />
    <xacro:wheel_gazebo_props prefix="back_right" />
    <xacro:wheel_gazebo_props prefix="front_left" />
    <xacro:wheel_gazebo_props prefix="middle_left" />
    <xacro:wheel_gazebo_props prefix="back_left" />

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <joint name="base_front_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="front_right_wheel_link" />
	<origin xyz="${base_length / 3.0} ${-(base_width + wheel_length) / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_middle_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="middle_right_wheel_link" />
	<origin xyz="0 ${-(base_width + wheel_length) / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_back_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="back_right_wheel_link" />
	<origin xyz="${-base_length / 3.0} ${-(base_width + wheel_length) / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_front_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="front_left_wheel_link" />
	<origin xyz="${base_length / 3.0} ${(base_width + wheel_length) / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_middle_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="middle_left_wheel_link" />
	<origin xyz="0 ${(base_width + wheel_length) / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_back_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="back_left_wheel_link" />
	<origin xyz="${-base_length / 3.0} ${(base_width + wheel_length) / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

</robot>
