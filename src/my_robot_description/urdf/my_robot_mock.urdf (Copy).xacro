<?xml version="1.0"?>
<robot name="my_robot_mock" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="common_properties.xacro" />
    <xacro:include filename="$(find rover_body_description)/urdf/rover_body.urdf.xacro" />

    <xacro:include filename="rover_body_mock.ros2_control.xacro" />

    <xacro:include filename="$(find rover_arm_description)/urdf/rover_arm.urdf.xacro" />
    <xacro:include filename="$(find rover_arm_description)/urdf/rover_arm.ros2_control.xacro" />

    <!-- rover base frames -->
    <link name="world"/>
    <link name="base_footprint"/>
    <link name="base_link"/>
    <joint name="world_to_base_footprint" type="fixed">
        <parent link="world"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <joint name="base_footprint_to_base_link" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- rover body: detailed frame/suspensions/wheels, main link is body_frame -->
    <xacro:rover_body parent="base_link" prefix="body_">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:rover_body>

    <link name="arm_mount"/>
    <joint name="arm_mount_joint" type="fixed">
        <parent link="body_frame"/>
        <child link="arm_mount"/>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
    </joint>
    <link name="arm_base_link"/>
    <joint name="arm_mount_to_arm_base" type="fixed">
        <parent link="arm_mount"/>
        <child link="arm_base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:rover_arm parent="arm_base_link" prefix="">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:rover_arm>

    <link name="tool0"/>
    <joint name="ee_base_to_tool0" type="fixed">
        <parent link="ee_base"/>
        <child link="tool0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:arm_ros2_control name="rover_arm" use_gazebo="true"/>

    <gazebo>
        <plugin filename="libgz_ros2_control-system" name="">
            <parameters>$(optenv arm_ctrl_yaml /tmp/robot_controllers.yaml)</parameters>
        </plugin>
    </gazebo>

</robot>
