<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_arm_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo simulation for ERC 2026 rover arm — maintenance panel with switch plugins</description>
  <maintainer email="samuelmalacarne.sm@gmail.com">samuel</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz-sim8</depend>
  <depend>rclcpp</depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rover_arm_description</exec_depend>
  <exec_depend>rover_arm_panel_description</exec_depend>
  <exec_depend>rover_arm_moveit_config</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="${prefix}/lib"/>
  </export>
</package>
